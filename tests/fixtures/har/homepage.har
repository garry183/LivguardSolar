-cbe7e8.svg\"},\"/livguard-solar/home/5/go_solar_img_1.png\":{\"width\":680,\"height\":384,\"finalUrl\":\"/livguard-solar/home/5/go_solar_img_1-8caf89.png\"},\"/livguard/home/12/logo-thehindu.png\":{\"width\":433,\"height\":282,\"finalUrl\":\"/livguard/home/12/logo-thehindu-90330c.png\"},\"/livguard/home/12/logo-et.png\":{\"width\":433,\"height\":282,\"finalUrl\":\"/livguard/home/12/logo-et-8b2213.png\"},\"/livguard/home/12/logo-nbs.png\":{\"width\":432,\"height\":281,\"finalUrl\":\"/livguard/home/12/logo-nbs-795604.png\"},\"/livguard/home/12/logo-toi.png\":{\"width\":433,\"height\":280,\"finalUrl\":\"/livguard/home/12/logo-toi-5a27b2.png\"},\"/livguard/home/12/logo-indiablooms.png\":{\"width\":432,\"height\":282,\"finalUrl\":\"/livguard/home/12/logo-indiablooms-e61305.png\"},\"/livguard-solar/home/7/lgs_panIndia.png\":{\"width\":304,\"height\":168,\"finalUrl\":\"/livguard-solar/home/7/lgs_panIndia-c13ef7.png\"},\"/livguard-solar/home/estimate-solar-power/solar-power.png\":{\"width\":516,\"height\":319,\"finalUrl\":\"/livguard-solar/home/estimate-solar-power/solar-power-710132.png\"}},\"ogImage\":\"https://livguard.b-cdn.net/livguard-solar/homePage/1/og-homePage-page.jpg?quality=85\\u0026width=764\",\"featuredProducts\":[{\"slug\":\"lgv12v75\",\"modelNumber\":\"LGV12V75\",\"humanReadableString\":\"Polycrystalline Solar Panel | 12V Capacity | 75 Wp Power\",\"type\":2,\"subType\":2,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":12,\"solarPanel_power\":75,\"solarPanel_numberOfCells\":36,\"solarPanel_voltageAtMaxPower\":18,\"solarPanel_maxSystemVoltage\":600,\"warranty\":5,\"warranty_unit\":\"years\",\"length\":705,\"height\":665,\"width\":35,\"dimensions_unit\":\"mm\",\"displaySlug\":\"poly-solar-panel-12v-capacity-75-wp-power-lgv12v75\"},{\"slug\":\"lgv12v100\",\"modelNumber\":\"LGV12V100\",\"humanReadableString\":\"Polycrystalline Solar Panel | 12V Capacity | 100 Wp Power\",\"type\":2,\"subType\":2,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":12,\"solarPanel_power\":100,\"solarPanel_numberOfCells\":36,\"solarPanel_voltageAtMaxPower\":18,\"solarPanel_maxSystemVoltage\":600,\"warranty\":5,\"warranty_unit\":\"years\",\"length\":905,\"height\":665,\"width\":34,\"dimensions_unit\":\"mm\",\"displaySlug\":\"poly-solar-panel-12v-capacity-100-wp-power-lgv12v100\"},{\"slug\":\"lgv12vs150\",\"modelNumber\":\"LGV12VS150\",\"humanReadableString\":\"Polycrystalline Solar Panel | 12V Capacity | 150 Wp Power\",\"type\":2,\"subType\":2,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":12,\"solarPanel_power\":150,\"solarPanel_numberOfCells\":32,\"solarPanel_voltageAtMaxPower\":16.9,\"solarPanel_maxSystemVoltage\":1000,\"warranty\":5,\"warranty_unit\":\"years\",\"length\":1335,\"height\":665,\"width\":34,\"dimensions_unit\":\"mm\",\"displaySlug\":\"poly-solar-panel-12v-capacity-150-wp-power-lgv12vs150\"},{\"slug\":\"lgv24vs535wm\",\"modelNumber\":\"LGV24VS535WM\",\"humanReadableString\":\"Mono-Perc-Halfcut Solar Panel | 24V Capacity | 535 Wp Power\",\"type\":2,\"subType\":0,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":24,\"solarPanel_power\":535,\"solarPanel_numberOfCells\":144,\"solarPanel_voltageAtMaxPower\":41.43,\"solarPanel_maxSystemVoltage\":1500,\"warranty\":12,\"warranty_unit\":\"years\",\"length\":2256,\"height\":1133,\"width\":35,\"dimensions_unit\":\"mm\",\"displaySlug\":\"mono-perc-halfcut-solar-panel-24v-capacity-535-wp-power-lgv24vs535wm\"},{\"slug\":\"lgv24vs540wm\",\"modelNumber\":\"LGV24VS540WM\",\"humanReadableString\":\"Mono-Perc-Halfcut Solar Panel | 24V Capacity | 540 Wp Power\",\"type\":2,\"subType\":0,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":24,\"solarPanel_power\":540,\"solarPanel_numberOfCells\":144,\"solarPanel_voltageAtMaxPower\":41.81,\"solarPanel_maxSystemVoltage\":1500,\"warranty\":12,\"warranty_unit\":\"years\",\"length\":2279,\"height\":1133,\"width\":35,\"dimensions_unit\":\"mm\",\"displaySlug\":\"mono-perc-halfcut-solar-panel-24v-capacity-540-wp-power-lgv24vs540wm\"},{\"slug\":\"lgv24vs545wm\",\"modelNumber\":\"LGV24VS545WM\",\"humanReadableString\":\"Mono-Perc-Halfcut Solar Panel | 24V Capacity | 545 Wp Power\",\"type\":2,\"subType\":0,\"description\":\"Livguard Solar Panels are Polycrystalline/mono perc PV panels, IEC compliant having range from 40 W – 325 W. Our Panels are ideally suited for rooftop and agricultural applications.\",\"solarPanel_voltage\":24,\"solarPanel_power\":545,\"solarPanel_numberOfCells\":144,\"solarPanel_voltageAtMaxPower\":42.02,\"solarPanel_maxSystemVoltage\":1500,\"warranty\":12,\"warranty_unit\":\"years\",\"length\":415,\"height\":665,\"width\":34,\"dimensions_unit\":\"mm\",\"displaySlug\":\"mono-perc-halfcut-solar-panel-24v-capacity-545-wp-power-lgv24vs545wm\"}],\"faqs\":[{\"question\":\"How is solar better than a Diesel Generator as a backup system?\",\"answer\":\"While the initial capital cost of a Solar PV System may be higher than that of a DG System, it's important to note that DG Systems incur substantial fuel and maintenance expenses. In contrast, Solar PV Systems require no fuel and involve minimal, hassle-free maintenance. \"},{\"question\":\"What maintenance is required for a solar energy system?\",\"answer\":\"Solar systems require minimal maintenance, including occasional panel cleaning and inspections. Choose Livguard Solar, that ensures a hassle-free, efficient performance, and uninterrupted solar energy experience for you.\"},{\"question\":\"How many solar panels do I need to power my home or business?\",\"answer\":\"The number of solar panels required varies based on energy consumption. Livguard Solar's experts help you determine the ideal setup, ensuring cost-effective, sustainable power. Connect with us to book a consultation.\"},{\"question\":\"Can I install solar panels on my roof if it has a unique shape or material?\",\"answer\":\"Yes, solar panels can be customized to fit unique roof shapes and materials. At Livguard Solar, we offer tailor-fit solutions for you, based on the specific needs and requirements of your home.\"},{\"question\":\"Can I retrofit my existing solar panel system with an energy storage solution?\",\"answer\":\"Yes, existing solar panel systems can be retrofitted with energy storage solutions. Our SMUs convert the existing inverter battery into a Solar inverter battery a budget-friendly solution retrofitted to your current setup.\"}],\"cdnUrl\":\"https://cdndev.livguardsolar.com\",\"recaptchaSiteKey\":\"6LeSMHgrAAAAANi6AOyg0mh9VZ5YUKNddVnwS_GQ\"}},\"actionData\":null,\"errors\":null},\"future\":{\"v2_dev\":false,\"unstable_postcss\":false,\"unstable_tailwind\":false,\"v2_errorBoundary\":true,\"v2_headers\":false,\"v2_meta\":true,\"v2_normalizeFormMethod\":false,\"v2_routeConvention\":false}};</script><script type=\"module\" async=\"\">import \"https://cdndev.livguardsolar.com/build/manifest-A70DE41C.js\";\nimport * as route0 from \"https://cdndev.livguardsolar.com/build/root-ZIPP6G7M.js\";\nimport * as route1 from \"https://cdndev.livguardsolar.com/build/routes/index-SHPA6B63.js\";\nwindow.__remixRouteModules = {\"root\":route0,\"routes/index\":route1};\n\nimport(\"https://cdndev.li