import{i as y,m as f,n as v}from"https://cdndev.livguardsolar.com/build/_shared/chunk-26EVPE3N.js";import{a as g}from"https://cdndev.livguardsolar.com/build/_shared/chunk-4NKNWFQ3.js";import{a as C}from"https://cdndev.livguardsolar.com/build/_shared/chunk-RN63NAG7.js";import{d as c}from"https://cdndev.livguardsolar.com/build/_shared/chunk-UVX3UIWA.js";var o=c(C());var e=c(g()),A=()=>{let[n,u]=(0,o.useState)("0-0"),[r,i]=(0,o.useState)(0),[w,m]=(0,o.useState)(""),[p,l]=(0,o.useState)([]),[x,b]=(0,o.useState)("");(0,o.useEffect)(()=>{b(window.location.pathname)},[]);let d=x==="/rooftop-solar"?[{questions:[{question:"How often should I clean my rooftop solar system?",answer:"Cleaning your solar system every month will reduce the buildup of dust and debris, allowing ample surface for sunlight absorption."},{question:"Where should I place my solar inverter?",answer:"It is necessary to place your solar inverter in a dry and well-ventilated area to avoid any moisture or heat damage."},{question:"How long does a rooftop solar system last?",answer:"A solar system can last for more than 20-25 years with proper care and maintenance."}]}]:[{category:"General",categoryIndex:0,questions:[{question:"How many solar panels will I need?",answer:"The total number of solar panels needed for your home depends on the power requirements, usable roof area with optimal levels of sunlight, and several other factors which can only be determined after a site visit. Schedule a free survey by calling our helpline at +91 9999039039 (between 9 am to 6 pm)."},{question:"What is the difference between hybrid and on-grid solar system?",answer:"The main difference between on-grid and hybrid solar systems is battery storage. On-grid systems are directly connected to the power grid, providing power to your home and sending excess energy back to the grid; there is no battery storage. This makes on-grid systems cheaper to install. Hybrid systems also connect to the grid but have battery storage as well, which can be used as power backup during electricity cuts. Therefore hybrid solar solutions have a higher initial cost compared to on-grid systems."}]},{category:"Installation and Maintenance",categoryIndex:1,questions:[{question:"Who is responsible for maintenance and repairs?",answer:"Livguard offers end-to-end solar installation and maintenance support for your home and business systems. We have 78+ authorized service stations across India and a team of 1200+ skilled engineers to provide after sales support, maintenance and repairs."}]},{category:"Economics",categoryIndex:2,questions:[{question:"What are the upfront costs?",answer:"When you opt for Livguard Solar, there are no upfront costs or site survey charges. Simply call our helpline to schedule a site visit and get a detailed estimate for installation type, total cost, and time frame."},{question:"What is the warranty on the solar panels and the system?",answer:"Livguard solar panels are covered by a 12 year standard warranty and 27 year performance warranty. Additionally, all our solar inverter products are covered by a 10 year standard warranty to ensure long-lasting performance and peace-of-mind."}]}],q=t=>{if(m(t.target.value),t.target.value==="")l([]),i(0),u("0-0");else{let a=d.flatMap((s,N)=>s.questions.map((I,k)=>({question:I.question,categoryIndex:s.categoryIndex,questionIndex:`${N}-${k}`}))).filter(s=>s.question.toLowerCase().includes(t.target.value.toLowerCase()));l(a)}},h=t=>{u(n===t?null:t)};return(0,e.jsxs)("section",{className:" tw-bg-[#1A1A1A] tw-text-white tw-p-8 tw-rounded-lg relative tw-w-[90%] !tw-min-h-[400px] tw-max-w-[1440px]",style:{margin:"80px auto"},children:[(0,e.jsxs)("div",{className:"faqsandsearch",children:[(0,e.jsx)("h2",{className:"custom-font lg:tw-text-4xl tw-text-[24px] tw-font-bold lg:tw-mb-6",children:"FAQs:"}),(0,e.jsxs)("div",{className:"tw-text-center",children:[(0,e.jsxs)("form",{onSubmit:t=>t.preventDefault(),className:"relative w-full max-w-md",children:[(0,e.jsxs)